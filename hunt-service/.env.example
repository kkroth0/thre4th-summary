# Threat Hunting microservice environment
# OpenRouter API key (https://openrouter.ai/settings/keys) — required for analysis.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat-v3.1
# Shared secret the Node backend sends as the X-Hunt-Secret header.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
HUNT_SERVICE_SECRET=
