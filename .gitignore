# Stores em disco do backend — TODOS os dotfiles .json de server/.
# Guardam dado de usuário: chaves OpenRouter cifradas (.users.json), histórico
# de scans, watchlist de exposição, boletins, posts e a allow-list. Glob em vez
# de lista nominal porque a lista já ficou desatualizada uma vez: .scans.json,
# .posts.json, .exposure-*.json e .daily-summaries.json rodavam sem ignore.
server/.*.json

# Decks entregues pelo worker (.pptx no template SRR). Dado de usuário e pesado:
# fica no disco do servidor, nunca no histórico.
server/.feed-decks/

# Sessões do visual companion (brainstorming) · mockups locais
.superpowers/

# Rascunhos de sessao e material de referencia que ficam na raiz durante o
# trabalho. Sao seus, ficam no disco — so nao sujam o git status.
2026-*-*.txt
other-sites-examples/

# Insumo dos mapeamentos de hunting: o artefato versionado é server/data/*.json
hunting-docs/

# Persistent collector snapshots and article bodies
server/.feed-cache/
server/.malpedia-cache.json
server/.malpedia-cache.json.tmp
