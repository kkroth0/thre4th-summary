PORT=3001
SESSION_SECRET= # Required for production to persist sessions across restarts, generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

# ── Auth GitHub + BYOK ───────────────────────────────────────────────────────
# App base URL, usada no redirect do OAuth e nos redirects de volta ao front.
APP_BASE_URL=https://threatsumm4ry.app
# GitHub OAuth App (Settings > Developer settings > OAuth Apps). O callback deve
# ser exatamente  <APP_BASE_URL>/api/auth/github/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Login/cadastro é aberto para qualquer GitHub.
# Premium allow-list: quem pode usar Relatórios, Newsletter e Threat Hunting.
# Pode ficar vazio; nesse caso ninguém tem premium até ser adicionado pela UI.
GITHUB_ALLOWED_LOGINS=   # usernames separados por vírgula, ex.: kkroth0,fulano
GITHUB_ALLOWED_ORG=      # (opcional) org GitHub; exige membership (scope read:org)
# Quem pode editar allow-list premium, publicações e feeds RSS.
# Vazio => cai no GITHUB_ALLOWED_LOGINS acima. Se ambos vazios, ninguém é admin.
GITHUB_ADMIN_LOGINS=     # usernames separados por vírgula, ex.: kkroth0
# Chave-mestra p/ cifrar (AES-256-GCM) as chaves BYOK dos usuários em repouso.
# 32 bytes: gere com  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRETS_ENCRYPTION_KEY=
# OpenRouter usado por enriquecimento/relatorios. Modelo default: DeepSeek.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat-v3.1
OPENROUTER_DAILY_MODEL=openrouter/free
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
ALIENVAULT_API_KEY=
SHODAN_API_KEY=
RANSOMWARE_LIVE_API_KEY=

PHISHTANK_API_KEY=
PULSEDIVE_API_KEY=
CENSYS_API_KEY=

HYBRID_ANALYSIS_API_KEY=
METADEFENDER_API_KEY=
THREATFOX_API_KEY=
URLHAUS_API_KEY=
WHOIS_API_KEY=
XFORCE_API_KEY=
XFORCE_API_PASSWORD=
GOOGLE_SAFE_BROWSING_API_KEY=
BINARYEDGE_API_KEY=
GREYNOISE_API_KEY=
IPQS_API_KEY=
# NIST NVD 2.0 (CVE feed). Optional: raises the rate limit from 5 to 50 req/30s.
# Request one at https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# Guided Threat Hunting microservice (hunt-service/). Base URL of the Python
# FastAPI service (e.g. a Hugging Face Space) and the shared secret it expects.
HUNT_SERVICE_URL=
HUNT_SERVICE_SECRET=
